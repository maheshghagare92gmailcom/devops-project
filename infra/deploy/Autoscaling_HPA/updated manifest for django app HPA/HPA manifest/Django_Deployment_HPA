apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: django-hpa
  namespace: default
  labels:
    app: django
    component: autoscaling

spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: django

  # Minimum and maximum Django pods
  minReplicas: 1
  maxReplicas: 6

  metrics:

    # Scale based on CPU
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70

    # Scale based on Memory
    - type: Resource
      resource:
        name: memory
        target:
          type: Utilization
          averageUtilization: 80

  # ---------------------------------------------------------
  # SCALE DOWN
  # ---------------------------------------------------------
  behavior:
    scaleDown:

      # Wait 5 minutes before aggressively reducing replicas.
      # Helps prevent rapid scaling up/down (flapping).
      stabilizationWindowSeconds: 300

      policies:

        # Don't remove more than 50% of pods within 15 seconds.
        - type: Percent
          value: 50
          periodSeconds: 15

        # Don't remove more than 1 pod within 60 seconds.
        - type: Pods
          value: 1
          periodSeconds: 60

      # Choose the more conservative scale-down policy.
      selectPolicy: Min

    # ---------------------------------------------------------
    # SCALE UP
    # ---------------------------------------------------------
    scaleUp:

      # React immediately when workload increases.
      stabilizationWindowSeconds: 0

      policies:

        # Allow up to 100% increase every 15 seconds.
        - type: Percent
          value: 100
          periodSeconds: 15

        # Allow up to 4 additional pods every 15 seconds.
        - type: Pods
          value: 4
          periodSeconds: 15

      # Choose the more aggressive scale-up policy.
      selectPolicy: Max
